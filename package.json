    "ingest:itch": "tsx scripts/db-migrate.ts && tsx scripts/ingest-itch.ts",
    "ingest:steam": "tsx scripts/db-migrate.ts && tsx scripts/ingest-steam.ts",
    "ingest:affiliate": "tsx scripts/db-migrate.ts && tsx scripts/ingest-affiliate.ts",
    "catalog:unpublish-non-nsfw": "tsx scripts/db-migrate.ts && tsx scripts/unpublish-non-nsfw-listings.ts",
    "catalog:recycle-stale": "tsx scripts/db-migrate.ts && tsx scripts/recycle-stale-listings.ts",
    "catalog:counts": "tsx scripts/db-migrate.ts && tsx scripts/catalog-counts.ts",
    "catalog:check-links": "tsx scripts/db-migrate.ts && tsx scripts/check-listing-links.ts",
    "catalog:audit-outbound": "tsx scripts/db-migrate.ts && tsx scripts/audit-outbound-pairs.ts",
