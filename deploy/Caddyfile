# Until DNS points here, browse by IP over HTTP (no TLS on raw IP).
http://159.203.136.220 {
	encode gzip
	reverse_proxy 127.0.0.1:3000

	handle_errors 502 503 504 {
		root * /var/www/nsfwdroid/deploy
		rewrite * /maintenance.html
		file_server
	}
}

# Apex → www so Google only indexes one host (canonical in HTML points at www).
# force_automate keeps Let's Encrypt certificates for these names. Without it,
# Caddy serves the admin origin cert, whose SAN is *.nsfwdroid.com and nsfwdroid.com.
nsfwdroid.com {
	tls force_automate
	redir https://www.nsfwdroid.com{uri} permanent
}

www.nsfwdroid.com {
	tls force_automate
	encode gzip

	# Admin UI lives on admin.nsfwdroid.com (same app). Keep the query string.
	@admin path /admin /admin/* /api/admin /api/admin/*
	redir @admin https://admin.nsfwdroid.com{uri} 308

	reverse_proxy 127.0.0.1:3000

	handle_errors 502 503 504 {
		root * /var/www/nsfwdroid/deploy
		rewrite * /maintenance.html
		file_server
	}
}

# Staff portal. Cloudflare origin certificate so Full (strict) works on this host.
# www is Let's Encrypt because `tls force_automate` prefers that exact name over the wildcard.
# The origin certificate also lists nsfwdroid.com, so the apex handshake can present it.
admin.nsfwdroid.com {
	tls /etc/caddy/certs/cloudflare-origin.pem /etc/caddy/certs/cloudflare-origin.key
	encode gzip
	reverse_proxy 127.0.0.1:3000

	handle_errors 502 503 504 {
		root * /var/www/nsfwdroid/deploy
		rewrite * /maintenance.html
		file_server
	}
}
