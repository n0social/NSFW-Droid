# Copy to /etc/cron.d/nsfwdroid-ingest on the droplet (chmod 644).
# Catalog refresh 3×/day (06:00, 14:00, 22:00 UTC) via catalog-maintenance.sh.
# Order: migrate → recycle stale → ingest (re-seen feed rows refresh listing.updated_at).
0 6,14,22 * * * root /var/www/nsfwdroid/scripts/catalog-maintenance.sh -- /var/www/nsfwdroid/scripts/catalog-ingest-cron.sh >> /var/log/nsfwdroid-ingest.log 2>&1
