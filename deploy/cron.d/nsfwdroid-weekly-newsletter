# Weekly member newsletter — Friday 20:00 UTC (evening send; picks = rolling 7d analytics).
# Requires NEWSLETTER_ENABLED=1 and NEWSLETTER_TRANSPORT=sendmail in /etc/nsfwdroid.env.
# Log: /var/log/nsfwdroid-newsletter.log
#
0 20 * * 5 root flock -n /var/lock/nsfwdroid-newsletter.lock /var/www/nsfwdroid/scripts/catalog-maintenance.sh -- npx --yes tsx scripts/send-weekly-newsletter.ts >> /var/log/nsfwdroid-newsletter.log 2>&1
