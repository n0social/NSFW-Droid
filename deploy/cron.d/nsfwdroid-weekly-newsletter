# Weekly member newsletter — Sunday 12:00 UTC (after weekly ingest window).
# Requires NEWSLETTER_ENABLED=1 and BREVO_API_KEY in /etc/nsfwdroid.env.
# Log: /var/log/nsfwdroid-newsletter.log
#
0 12 * * 0 root flock -n /var/lock/nsfwdroid-newsletter.lock /var/www/nsfwdroid/scripts/catalog-maintenance.sh -- npx --yes tsx scripts/send-weekly-newsletter.ts >> /var/log/nsfwdroid-newsletter.log 2>&1
