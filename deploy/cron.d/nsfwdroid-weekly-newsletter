# Weekly member newsletter — Friday 9:00 PM US Eastern (America/New_York; EST/EDT).
# Requires NEWSLETTER_ENABLED=1 and NEWSLETTER_TRANSPORT=sendmail in /etc/nsfwdroid.env.
# Log: /var/log/nsfwdroid-newsletter.log
#
CRON_TZ=America/New_York
0 21 * * 5 root flock -n /var/lock/nsfwdroid-newsletter.lock /var/www/nsfwdroid/scripts/weekly-newsletter-cron.sh >> /var/log/nsfwdroid-newsletter.log 2>&1
