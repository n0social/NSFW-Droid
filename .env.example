DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
NEXT_PUBLIC_SITE_URL=https://www.nsfwdroid.com
# GA4 — use the Measurement ID from Firebase → Project settings → Your apps (web) or GA4 property linked to the same project
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T6WLS2QZ7L
# Adult display ads (ExoClick etc.) — off until network + age gate verified in production
NEXT_PUBLIC_ADS_ENABLED=0
# Optional affiliate program export (see scripts/ingest-affiliate.ts)
# AFFILIATE_EXPORT_PATH=data/affiliate-export.json

# Firebase — https://console.firebase.google.com/ → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server session (POST /api/auth/session) — Service accounts → Generate new private key (JSON one line)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SESSION_SECRET=

# Auto-publish TOS-clear candidates (default on when NODE_ENV=production)
# AUTO_PUBLISH=1
# Strict manual review for all ingest (overrides AUTO_PUBLISH)
# INGEST_REQUIRE_REVIEW=1
# Legacy local demo: auto-publish in dev without NODE_ENV=production
DEMO_AUTO_PUBLISH=0
ADMIN_PASSWORD=
STEAM_WEB_API_KEY=
STEAM_INGEST_MAX_APPS=250
STEAM_INCLUDE_SEXUAL_DESCRIPTOR=0
STEAM_SEARCH_PER_TERM=50
# STEAM_SEARCH_TERMS=nsfw,adult only,visual novel
STEAM_DETAIL_DELAY_MS=280
STEAM_USE_APPLIST_DELTA=0
STEAM_DEMO_APP_IDS=
INGEST_AUTO_PUBLISH_LIMIT=500
# itch: default = NSFW tag browse only (ITCH_NSFW_ONLY=1). Set ITCH_NSFW_ONLY=0 to also pull new/featured/sales.
ITCH_NSFW_ONLY=1
# Require mature signals before auto-publish (itch tags/keywords, Steam adult descriptor)
CATALOG_NSFW_ONLY=1
# itch: override feeds entirely:
# ITCH_FEED_URLS=https://itch.io/games/tag-nsfw.xml
# ITCH_EXTRA_FEED_URLS=https://itch.io/games/tag-yuri.xml
# ITCH_MINIMAL_FEEDS=1
ITCH_FEED_DELAY_MS=500
ITCH_RATE_LIMIT_BACKOFF_MS=2500
