DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
NEXT_PUBLIC_SITE_URL=https://www.nsfwdroid.com
# GA4 — use the Measurement ID from Firebase → Project settings → Your apps (web) or GA4 property linked to the same project
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T6WLS2QZ7L
# Adult display ads (ExoClick) — off until network approval + age gate verified in production
NEXT_PUBLIC_ADS_ENABLED=0
# Zone IDs from ExoClick dashboard (NEXT_PUBLIC_ required — inlined at build time)
NEXT_PUBLIC_EXOCLICK_ZONE_ID_BANNER=
NEXT_PUBLIC_EXOCLICK_ZONE_ID_NATIVE=
# Popunder on Play / Play on store (zone 6062592 in public/exoclick-popunder.js)
NEXT_PUBLIC_EXOCLICK_ZONE_ID_POPUNDER=6062592
# NEXT_PUBLIC_EXOCLICK_POPUNDER_SCRIPT_SRC=/exoclick-popunder.js
# Ad tag script URL from your zone snippet (do not load until ADS_ENABLED=1)
# NEXT_PUBLIC_EXOCLICK_AD_SCRIPT_URL=https://a.magsrv.com/ad-provider.js
# Optional <ins> class from the same snippet (e.g. eas6a97888e2)
# NEXT_PUBLIC_EXOCLICK_INS_CLASS=
# Optional affiliate program export (see data/affiliate-export.example.json)
# AFFILIATE_EXPORT_PATH=data/affiliate-export.json
# itch.io Partner program: append ?ac=CODE to itch URLs in ingest (only when set — https://itch.io/partners)
# ITCH_AFFILIATE_USERNAME=your_partner_code
# ITCH_REF=your_partner_code

# Firebase — https://console.firebase.google.com/ → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server session (POST /api/auth/session) — Service accounts → Generate new private key (JSON one line)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SESSION_SECRET=

# Auto-publish TOS-clear candidates (default on when NODE_ENV=production)
# AUTO_PUBLISH=1
# Strict manual review for all ingest (overrides AUTO_PUBLISH)
# INGEST_REQUIRE_REVIEW=1
# Legacy local demo: auto-publish in dev without NODE_ENV=production
DEMO_AUTO_PUBLISH=0
ADMIN_PASSWORD=
# Admin session cookie HMAC (openssl rand -base64 32). If unset, signs with ADMIN_PASSWORD until you set this.
# ADMIN_SESSION_SECRET=
STEAM_WEB_API_KEY=
STEAM_INGEST_MAX_APPS=400
STEAM_INCLUDE_SEXUAL_DESCRIPTOR=1
STEAM_SEARCH_PER_TERM=80
# STEAM_SEARCH_TERMS=nsfw,adult only,visual novel
STEAM_DETAIL_DELAY_MS=280
STEAM_USE_APPLIST_DELTA=0
STEAM_DEMO_APP_IDS=
INGEST_AUTO_PUBLISH_LIMIT=500
# Editorial target for live catalog size (admin dashboard hint only — does not delete rows)
# CATALOG_SOFT_CAP=500
# itch: default = NSFW tag browse only (ITCH_NSFW_ONLY=1). Set ITCH_NSFW_ONLY=0 to also pull new/featured/sales.
ITCH_NSFW_ONLY=1
# When NSFW-only, also pull site-wide new.xml (per-item mature filter still applies). Default on.
# ITCH_INCLUDE_SITE_NEW_FEED=0
# Search RSS seeds: data/itch-search-feed-queries.json (CoC, TiTS, etc.)
# Require mature signals before auto-publish (itch tags/keywords, Steam adult descriptor)
CATALOG_NSFW_ONLY=1
# Homepage Featured rail + hero (comma-separated slugs, order preserved). Or set chart_bucket=featured on listings.
# FEATURED_LISTING_SLUGS=example-slug,another-slug
# itch: override feeds entirely:
# ITCH_FEED_URLS=https://itch.io/games/tag-nsfw.xml
# ITCH_EXTRA_FEED_URLS=https://itch.io/games/tag-yuri.xml
# ITCH_MINIMAL_FEEDS=1
ITCH_FEED_DELAY_MS=500
ITCH_RATE_LIMIT_BACKOFF_MS=2500

# Weekly member newsletter (Phase 1 — see docs/reward_program.md; off until NEWSLETTER_ENABLED=1)
NEWSLETTER_ENABLED=0
# Droplet Exim: sendmail. Leave unset to use Brevo (BREVO_API_KEY required).
# NEWSLETTER_TRANSPORT=sendmail
# Public base URL for confirm/unsubscribe links in email (defaults to NEXT_PUBLIC_SITE_URL)
# NEWSLETTER_PUBLIC_BASE_URL=https://www.nsfwdroid.com
# Brevo Transactional Email API (newsletter confirm + weekly send)
# BREVO_API_KEY=xkeysib-xxxxxxxx
# Optional override for From (else ALERT_EMAIL_FROM). Domain must be authenticated in Brevo.
# Use a verified domain in production, e.g. NSFW Droid <newsletter@nsfwdroid.com>
# NEWSLETTER_FROM=NSFW Droid <newsletter@nsfwdroid.com>
# Or bare email + display name (defaults to "NSFW Droid" when unset):
# NEWSLETTER_FROM=newsletter@nsfwdroid.com
# NEWSLETTER_FROM_NAME=NSFW Droid
# NEWSLETTER_TOKEN_SECRET=  # HMAC for unsubscribe links; else SESSION_SECRET (required in production)
# NEWSLETTER_RANK_DAYS=7
# NEWSLETTER_CLICK_WEIGHT=2

# Ops alerts (droplet /etc/nsfwdroid.env — scripts/alert-email.sh, watchdog + weekly cron)
# ALERT_EMAIL_FROM also used as newsletter From when sending is enabled
# ALERT_EMAIL_TO=ops@example.com
# ALERT_EMAIL=ops@example.com   # alias for ALERT_EMAIL_TO
# ALERT_EMAIL_FROM=alerts@nsfwdroid.com
# ALERT_EMAIL_TRANSPORT=sendmail   # droplet default; use smtp with SMTP_* below
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_DEDUPE_MINUTES=30
# Post-ingest: alert if last N ingest_all runs inserted 0 new candidates (0/unset = off)
# INGEST_ALERT_ZERO_NEW_RUNS=3
# WATCHDOG_RESTART=1            # 0 = email only, no systemctl restart (droplet watchdog)
# EXIM_RELAY_SMOKE_WEEKLY=1     # 0 = skip Exim smoke during weekly-maintenance-inner.sh
# INGEST_ALERT_MAX_AGE_HOURS=18
# Social — Mastodon / Fediverse (+ Pillowfort outbox when enabled)
# SOCIAL_MASTODON_ENABLED=0
# MASTODON_INSTANCE_URL=https://mastodon.social
# MASTODON_ACCESS_TOKEN=   # from scripts/mastodon-oauth-token.ts (not your login password); needs write:accounts to edit profile
# MASTODON_CLIENT_ID=      # local oauth helper only — Preferences → Development
# MASTODON_CLIENT_SECRET=
# SOCIAL_MAX_PER_INGEST=3
# SOCIAL_MAX_PER_DAY=15
# SOCIAL_ENQUEUE_WINDOW_HOURS=72
# MASTODON_VISIBILITY=public
# MASTODON_ATTACH_COVER=1   # default on — listing cover image on each post; set 0 for text-only
# SOCIAL_DRY_RUN=0
# PILLOWFORT_ENABLED=0

# Optional weekly maintenance extras (default off)
# NSFWDROID_WEEKLY_INGEST=0
# NSFWDROID_WEEKLY_NPM_CI=0
# Manual banner override (normally data/maintenance-notice.json from cron)
# MAINTENANCE_NOTICE_UNTIL=2026-01-01T04:00:00Z
