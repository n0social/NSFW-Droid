DATABASE_URL=postgresql://catalog:catalog@localhost:5432/catalog
NEXT_PUBLIC_SITE_URL=https://www.nsfwdroid.com
# GA4 — use the Measurement ID from Firebase → Project settings → Your apps (web) or GA4 property linked to the same project
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T6WLS2QZ7L

# Firebase — https://console.firebase.google.com/ → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server session (POST /api/auth/session) — Service accounts → Generate new private key (JSON one line)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SESSION_SECRET=

# Auto-publish TOS-clear candidates (default on when NODE_ENV=production)
# AUTO_PUBLISH=1
# Strict manual review for all ingest (overrides AUTO_PUBLISH)
# INGEST_REQUIRE_REVIEW=1
# Legacy local demo: auto-publish in dev without NODE_ENV=production
DEMO_AUTO_PUBLISH=0
ADMIN_PASSWORD=
STEAM_WEB_API_KEY=
STEAM_INGEST_MAX_APPS=60
STEAM_DEMO_APP_IDS=
# Comma-separated itch RSS feeds (default: new.xml only)
# ITCH_FEED_URLS=https://itch.io/feed/new.xml,https://itch.io/feed/featured.xml
